# ✅ These values MUST be known BEFORE running Terraform.
# 🔁 Everything in <angle brackets> MUST be replaced.
# 💡 Values without <> are optional and can be left as-is if not needed (e.g. no private image registry).
#    It will still create a secret, but it won't be valid.

# Project related values
PROJECT_NAME="test-cluster"
PROJECT_STAGE="local"

# Argo CD related values
# Initial Admin Account Password for Argo CD.
ARGOCD_WIZARD_ACCOUNT_PASSWORD="magic"

# Git repository values
# The HTTPS URL of the git repository that Argo CD will use to pull the kubara generated manifests from.
ARGOCD_GIT_HTTPS_URL="https://github.com/Rana-Ashar/kubara-local-testing.git"

# Optional: Git repository credentials for Argo to pull your kubara manifests from.
# Necessary if your repository isn't public.
ARGOCD_GIT_USERNAME=""
ARGOCD_GIT_PAT_OR_PASSWORD=""

# Optional: Helm repository values (leave empty to disable).
# ARGOCD_HELM_REPO_URL supports: https://... (classic Helm repo) or registry.example.com/... (OCI Helm registry).
# Compatibility: oci://... is also accepted and normalized automatically.
ARGOCD_HELM_REPO_USERNAME=""
ARGOCD_HELM_REPO_PASSWORD=""
ARGOCD_HELM_REPO_URL=""

# Optional: Container Registry Config
# the variable must be base64 encoded - how to: https://docs.kubara.io/latest-stable/6_reference/faq/#how-do-i-create-a-dockerconfigjson-for-env-file
DOCKERCONFIG_BASE64=""
