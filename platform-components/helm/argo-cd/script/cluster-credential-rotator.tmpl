#!/bin/sh

set -u
umask 077

RELEASE_NAMESPACE={{ .Release.Namespace | quote }}
LABEL_KEY={{ .Values.clusterCredentialRotator.secret.labelKey | quote }}
LABEL_VALUE={{ .Values.clusterCredentialRotator.secret.labelValue | quote }}
REQUIRED_TYPE={{ .Values.clusterCredentialRotator.secret.requiredType | quote }}
BOOTSTRAP_KUBECONFIG_KEY={{ .Values.clusterCredentialRotator.secret.bootstrapKubeconfigKey | quote }}
GENERATED_CONFIG_KEY={{ .Values.clusterCredentialRotator.secret.generatedConfigKey | quote }}
REMOTE_NAMESPACE={{ .Values.clusterCredentialRotator.remoteAccess.namespace | quote }}
REMOTE_SERVICE_ACCOUNT_NAME={{ .Values.clusterCredentialRotator.remoteAccess.serviceAccountName | quote }}
REMOTE_CLUSTER_ROLE_BINDING_NAME={{ .Values.clusterCredentialRotator.remoteAccess.clusterRoleBindingName | quote }}
REMOTE_CLUSTER_ROLE_NAME={{ .Values.clusterCredentialRotator.remoteAccess.clusterRoleName | quote }}
TOKEN_DURATION={{ .Values.clusterCredentialRotator.token.duration | quote }}
REFRESH_BEFORE={{ .Values.clusterCredentialRotator.token.refreshBefore | quote }}

ISSUED_AT_ANNOTATION="kubara.io/cluster-credential-issued-at"
EXPIRES_AT_ANNOTATION="kubara.io/cluster-credential-expires-at"
MANAGED_BY_ANNOTATION="kubara.io/cluster-credential-managed-by"
MANAGED_BY_VALUE="cluster-credential-rotator"

log() (
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"
)

duration_to_seconds() (
  awk -v value="$1" '
    function fail() { exit 1 }
    BEGIN {
      rest = value
      total = 0

      if (rest == "") {
        fail()
      }

      while (rest != "") {
        if (match(rest, /^[0-9]+[smhd]/) == 0) {
          fail()
        }

        part = substr(rest, RSTART, RLENGTH)
        amount = substr(part, 1, length(part) - 1) + 0
        unit = substr(part, length(part), 1)

        if (unit == "s") {
          multiplier = 1
        } else if (unit == "m") {
          multiplier = 60
        } else if (unit == "h") {
          multiplier = 3600
        } else if (unit == "d") {
          multiplier = 86400
        } else {
          fail()
        }

        total += amount * multiplier
        rest = substr(rest, RLENGTH + 1)
      }

      print total
    }
  ' </dev/null
)

rfc3339_to_epoch() (
  value=$1

  case "$value" in
    ????-??-??T??:??:??*Z)
      ;;
    *)
      return 1
      ;;
  esac

  # Kubernetes returns UTC RFC3339 timestamps. BusyBox date accepts the
  # equivalent "YYYY-MM-DD HH:MM:SS" form; strip optional fractional seconds.
  normalized="$(
    printf '%s' "$value" |
      sed 's/\.[0-9][0-9]*Z$/Z/; s/T/ /; s/Z$//'
  )"

  date -u -d "$normalized" +%s 2>/dev/null
)

json_escape() (
  printf '%s' "$1" | awk '
    BEGIN { ORS = "" }
    {
      if (NR > 1) {
        printf "\\n"
      }
      gsub(/\\/, "\\\\")
      gsub(/"/, "\\\"")
      gsub(/\r/, "\\r")
      gsub(/\t/, "\\t")
      printf "%s", $0
    }
  '
)

get_secret_annotation() (
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secret "$1" \
    -o "jsonpath={.metadata.annotations['$2']}"
)

get_secret_data() (
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secret "$1" \
    -o "jsonpath={.data['$2']}"
)

get_secret_value() (
  encoded_value="$(get_secret_data "$1" "$2")" || return 1

  if [ -z "$encoded_value" ]; then
    return 0
  fi

  printf '%s' "$encoded_value" | base64 -d
)

get_secret_type() (
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secret "$1" \
    -o jsonpath='{.type}'
)

build_generated_kubeconfig() (
  kubeconfig_path=$1
  server=$2
  ca_data=$3
  insecure=$4
  token=$5

  case "$insecure" in
    true)
      cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    insecure-skip-tls-verify: true
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: managed-service-account
  name: managed-cluster
current-context: managed-cluster
users:
- name: managed-service-account
  user:
    token: ${token}
EOF_KUBECONFIG
      ;;
    false)
      if [ -n "$ca_data" ]; then
        cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    certificate-authority-data: ${ca_data}
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: managed-service-account
  name: managed-cluster
current-context: managed-cluster
users:
- name: managed-service-account
  user:
    token: ${token}
EOF_KUBECONFIG
      else
        # No custom CA means use the container/system trust store.
        cat >"$kubeconfig_path" <<EOF_KUBECONFIG
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: ${server}
  name: managed-cluster
contexts:
- context:
    cluster: managed-cluster
    user: managed-service-account
  name: managed-cluster
current-context: managed-cluster
users:
- name: managed-service-account
  user:
    token: ${token}
EOF_KUBECONFIG
      fi
      ;;
    *)
      return 1
      ;;
  esac
)

generated_config_token() (
  printf '%s' "$1" | sed -n 's/.*"bearerToken":"\([^"]*\)".*/\1/p'
)

generated_config_ca_data() (
  printf '%s' "$1" | sed -n 's/.*"caData":"\([^"]*\)".*/\1/p'
)

generated_config_insecure() (
  printf '%s' "$1" | sed -n 's/.*"insecure":\([^,}]*\).*/\1/p'
)

validate_generated_credentials() (
  validation_kubeconfig=$1
  server=$2
  ca_data=$3
  insecure=$4
  token=$5

  build_generated_kubeconfig \
    "$validation_kubeconfig" \
    "$server" \
    "$ca_data" \
    "$insecure" \
    "$token" || return 1

  kubectl \
    --kubeconfig "$validation_kubeconfig" \
    get namespace kube-system \
    >/dev/null
)

ensure_remote_access() (
  bootstrap_kubeconfig=$1

  cat <<EOF_REMOTE | kubectl --kubeconfig "$bootstrap_kubeconfig" apply -f - >/dev/null
apiVersion: v1
kind: Namespace
metadata:
  name: ${REMOTE_NAMESPACE}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ${REMOTE_SERVICE_ACCOUNT_NAME}
  namespace: ${REMOTE_NAMESPACE}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ${REMOTE_CLUSTER_ROLE_BINDING_NAME}
subjects:
  - kind: ServiceAccount
    name: ${REMOTE_SERVICE_ACCOUNT_NAME}
    namespace: ${REMOTE_NAMESPACE}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ${REMOTE_CLUSTER_ROLE_NAME}
EOF_REMOTE
)

mint_service_account_token() (
  kubeconfig=$1
  output_file=$2

  # Use the TokenRequest response rather than assuming the requested duration
  # was granted. Kubernetes may shorten or extend the requested lifetime.
  kubectl \
    --kubeconfig "$kubeconfig" \
    -n "$REMOTE_NAMESPACE" \
    create token "$REMOTE_SERVICE_ACCOUNT_NAME" \
    --duration="${TOKEN_DURATION_SECONDS}s" \
    -o jsonpath='{.status.token}{"\n"}{.status.expirationTimestamp}{"\n"}' \
    >"$output_file"
)

refresh_due() (
  expires_at=$1
  refresh_after_epoch=$2

  case "$expires_at" in
    ''|*[!0-9]*)
      # Missing or malformed expiry metadata is repaired by rotating.
      return 0
      ;;
  esac

  [ "$refresh_after_epoch" -ge "$expires_at" ]
)

patch_secret_with_credentials() (
  secret_name=$1
  patch_file=$2
  cluster_name=$3
  server=$4
  generated_config=$5
  issued_at=$6
  expires_at=$7

  escaped_name="$(json_escape "$cluster_name")" || return 1
  escaped_server="$(json_escape "$server")" || return 1
  escaped_config="$(json_escape "$generated_config")" || return 1

  cat >"$patch_file" <<EOF_PATCH
{
  "metadata": {
    "labels": {
      "argocd.argoproj.io/secret-type": "cluster",
      "${LABEL_KEY}": "${LABEL_VALUE}"
    },
    "annotations": {
      "${ISSUED_AT_ANNOTATION}": "${issued_at}",
      "${EXPIRES_AT_ANNOTATION}": "${expires_at}",
      "${MANAGED_BY_ANNOTATION}": "${MANAGED_BY_VALUE}"
    }
  },
  "stringData": {
    "name": "${escaped_name}",
    "server": "${escaped_server}",
    "${GENERATED_CONFIG_KEY}": "${escaped_config}"
  }
}
EOF_PATCH

  kubectl \
    -n "$RELEASE_NAMESPACE" \
    patch secret "$secret_name" \
    --type merge \
    --patch-file "$patch_file" \
    >/dev/null
)

reconcile_secret() (
  set -u

  secret_name=$1

  if ! bootstrap_kubeconfig_file=$(mktemp); then
    log "failed to create temporary bootstrap kubeconfig file"
    return 1
  fi
  if ! current_kubeconfig_file=$(mktemp); then
    rm -f "$bootstrap_kubeconfig_file"
    log "failed to create temporary current kubeconfig file"
    return 1
  fi
  if ! candidate_kubeconfig_file=$(mktemp); then
    rm -f "$bootstrap_kubeconfig_file" "$current_kubeconfig_file"
    log "failed to create temporary candidate kubeconfig file"
    return 1
  fi
  if ! token_request_file=$(mktemp); then
    rm -f "$bootstrap_kubeconfig_file" "$current_kubeconfig_file" "$candidate_kubeconfig_file"
    log "failed to create temporary token request file"
    return 1
  fi
  if ! patch_file=$(mktemp); then
    rm -f "$bootstrap_kubeconfig_file" "$current_kubeconfig_file" "$candidate_kubeconfig_file" "$token_request_file"
    log "failed to create temporary patch file"
    return 1
  fi

  trap 'rm -f "$bootstrap_kubeconfig_file" "$current_kubeconfig_file" "$candidate_kubeconfig_file" "$token_request_file" "$patch_file"' EXIT INT TERM

  if ! secret_type="$(get_secret_type "$secret_name")"; then
    log "failed to read type for secret ${secret_name}"
    return 1
  fi

  if [ -n "$REQUIRED_TYPE" ] && [ "$secret_type" != "$REQUIRED_TYPE" ]; then
    log "skipping ${secret_name}: expected secret type ${REQUIRED_TYPE}, found ${secret_type:-<empty>}"
    return 0
  fi

  if ! current_config="$(get_secret_value "$secret_name" "$GENERATED_CONFIG_KEY")"; then
    log "failed to read generated config from secret ${secret_name}"
    return 1
  fi

  if ! current_epoch="$(date +%s)"; then
    log "failed to determine current time while reconciling ${secret_name}"
    return 1
  fi
  case "$current_epoch" in
    ''|*[!0-9]*)
      log "current time is not a valid epoch value while reconciling ${secret_name}"
      return 1
      ;;
  esac
  refresh_after_epoch=$((current_epoch + REFRESH_BEFORE_SECONDS))

  if [ -z "$current_config" ]; then
    # ---------------------------------------------------------------------
    # FIRST ONBOARDING
    # ---------------------------------------------------------------------
    # bootstrapKubeconfig is authoritative only while no generated config
    # exists. Existing name/server/config remnants are deliberately ignored.
    cluster_name="$secret_name"

    log "no generated credentials found for ${secret_name}; using bootstrap credentials for initial onboarding"

    if ! bootstrap_kubeconfig="$(get_secret_value "$secret_name" "$BOOTSTRAP_KUBECONFIG_KEY")"; then
      log "failed to read bootstrap kubeconfig from secret ${secret_name}"
      return 1
    fi

    if [ -z "$bootstrap_kubeconfig" ]; then
      log "secret ${secret_name} is missing required bootstrap key ${BOOTSTRAP_KUBECONFIG_KEY}"
      return 1
    fi

    if ! printf '%s' "$bootstrap_kubeconfig" >"$bootstrap_kubeconfig_file"; then
      log "failed to write bootstrap kubeconfig for ${secret_name}"
      return 1
    fi

    if ! server="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.server}'
    )"; then
      log "failed to read cluster server from bootstrap kubeconfig for ${secret_name}"
      return 1
    fi

    if [ -z "$server" ]; then
      log "bootstrap kubeconfig for ${secret_name} did not yield a cluster server endpoint"
      return 1
    fi

    if ! ca_data="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.certificate-authority-data}'
    )"; then
      log "failed to read cluster CA data from bootstrap kubeconfig for ${secret_name}"
      return 1
    fi

    if ! insecure="$(
      kubectl \
        --kubeconfig "$bootstrap_kubeconfig_file" \
        config view \
        --raw \
        --flatten \
        --minify \
        -o jsonpath='{.clusters[0].cluster.insecure-skip-tls-verify}'
    )"; then
      log "failed to read TLS settings from bootstrap kubeconfig for ${secret_name}"
      return 1
    fi

    if [ -z "$insecure" ]; then
      insecure="false"
    fi

    case "$insecure" in
      true|false)
        ;;
      *)
        log "bootstrap kubeconfig for ${secret_name} contains an invalid insecure-skip-tls-verify value"
        return 1
        ;;
    esac

    log "onboarding remote access for ${secret_name}"

    if ! ensure_remote_access "$bootstrap_kubeconfig_file"; then
      log "failed to provision remote access for ${secret_name}"
      return 1
    fi

    if ! mint_service_account_token "$bootstrap_kubeconfig_file" "$token_request_file"; then
      log "failed to mint initial service account token for ${secret_name}"
      return 1
    fi
  else
    # ---------------------------------------------------------------------
    # NORMAL ROTATION
    # ---------------------------------------------------------------------
    # Once generated config exists, bootstrap credentials are intentionally
    # not read or used. If the managed identity is broken, rotation fails and
    # requires explicit operator intervention/re-onboarding.

    if ! cluster_name="$(get_secret_value "$secret_name" "name")"; then
      log "failed to read cluster name from secret ${secret_name}"
      return 1
    fi

    if [ -z "$cluster_name" ]; then
      cluster_name="$secret_name"
    fi

    if ! server="$(get_secret_value "$secret_name" "server")"; then
      log "failed to read cluster server from secret ${secret_name}"
      return 1
    fi

    if [ -z "$server" ]; then
      log "generated credentials exist for ${secret_name}, but the server field is missing"
      return 1
    fi

    current_token="$(generated_config_token "$current_config")"
    ca_data="$(generated_config_ca_data "$current_config")"
    insecure="$(generated_config_insecure "$current_config")"

    if [ -z "$current_token" ]; then
      log "generated credentials for ${secret_name} do not contain a bearer token"
      return 1
    fi

    if [ -z "$insecure" ]; then
      log "generated credentials for ${secret_name} do not contain a valid TLS insecure flag"
      return 1
    fi

    case "$insecure" in
      true|false)
        ;;
      *)
        log "generated credentials for ${secret_name} contain an invalid TLS insecure flag"
        return 1
        ;;
    esac

    if ! build_generated_kubeconfig \
      "$current_kubeconfig_file" \
      "$server" \
      "$ca_data" \
      "$insecure" \
      "$current_token"; then
      log "failed to build current generated kubeconfig for ${secret_name}"
      return 1
    fi

    # Under the no-bootstrap-fallback contract, an invalid current credential
    # cannot self-heal. Fail clearly rather than attempting bootstrap recovery.
    if ! kubectl \
      --kubeconfig "$current_kubeconfig_file" \
      get namespace kube-system \
      >/dev/null; then
      log "current generated credentials for ${secret_name} are invalid; automatic rotation cannot continue without explicit re-onboarding"
      return 1
    fi

    if ! expires_at="$(get_secret_annotation "$secret_name" "$EXPIRES_AT_ANNOTATION")"; then
      log "failed to read expiry annotation from secret ${secret_name}"
      return 1
    fi

    if ! refresh_due "$expires_at" "$refresh_after_epoch"; then
      log "secret ${secret_name} already has valid generated credentials"
      return 0
    fi

    log "rotating credentials for ${secret_name} using current generated credentials"

    # Token A requests token B. bootstrapKubeconfig is not used in this path.
    if ! mint_service_account_token "$current_kubeconfig_file" "$token_request_file"; then
      log "failed to mint replacement service account token for ${secret_name}"
      return 1
    fi
  fi

  token="$(sed -n '1p' "$token_request_file")"
  expiration_timestamp="$(sed -n '2p' "$token_request_file")"

  if [ -z "$token" ]; then
    log "token request returned an empty token for ${secret_name}"
    return 1
  fi

  if [ -z "$expiration_timestamp" ]; then
    log "token request returned no expiration timestamp for ${secret_name}"
    return 1
  fi

  if ! expires_at="$(rfc3339_to_epoch "$expiration_timestamp")"; then
    log "failed to parse token expiration timestamp for ${secret_name}: ${expiration_timestamp}"
    return 1
  fi

  if ! issued_at="$(date +%s)"; then
    log "failed to determine token issue time for ${secret_name}"
    return 1
  fi
  case "$issued_at" in
    ''|*[!0-9]*)
      log "token issue time is not a valid epoch value for ${secret_name}"
      return 1
      ;;
  esac

  if [ "$expires_at" -le "$issued_at" ]; then
    log "token request returned an already-expired credential for ${secret_name}"
    return 1
  fi

  actual_lifetime=$((expires_at - issued_at))
  if [ "$actual_lifetime" -le "$REFRESH_BEFORE_SECONDS" ]; then
    log "token lifetime returned by the API server for ${secret_name} (${actual_lifetime}s) is not greater than refreshBefore (${REFRESH_BEFORE_SECONDS}s)"
    return 1
  fi

  generated_config="$(
    printf \
      '{"bearerToken":"%s","tlsClientConfig":{"caData":"%s","insecure":%s}}' \
      "$token" \
      "$ca_data" \
      "$insecure"
  )"

  # Candidate credential must work before the live Argo CD Secret is changed.
  if ! validate_generated_credentials \
    "$candidate_kubeconfig_file" \
    "$server" \
    "$ca_data" \
    "$insecure" \
    "$token"; then
    log "generated credentials for ${secret_name} failed validation"
    return 1
  fi

  if ! patch_secret_with_credentials \
    "$secret_name" \
    "$patch_file" \
    "$cluster_name" \
    "$server" \
    "$generated_config" \
    "$issued_at" \
    "$expires_at"; then
    log "failed to update generated credentials in secret ${secret_name}"
    return 1
  fi

  log "successfully refreshed credentials for ${secret_name}"
)

if ! TOKEN_DURATION_SECONDS="$(duration_to_seconds "$TOKEN_DURATION")"; then
  log "invalid token duration: ${TOKEN_DURATION}"
  exit 1
fi

if ! REFRESH_BEFORE_SECONDS="$(duration_to_seconds "$REFRESH_BEFORE")"; then
  log "invalid refresh-before duration: ${REFRESH_BEFORE}"
  exit 1
fi

if [ "$TOKEN_DURATION_SECONDS" -le 0 ]; then
  log "token duration must be greater than zero"
  exit 1
fi

if [ "$REFRESH_BEFORE_SECONDS" -lt 0 ]; then
  log "refreshBefore must not be negative"
  exit 1
fi

if [ "$REFRESH_BEFORE_SECONDS" -ge "$TOKEN_DURATION_SECONDS" ]; then
  log "refreshBefore (${REFRESH_BEFORE}) must be smaller than token duration (${TOKEN_DURATION})"
  exit 1
fi

if ! managed_secrets="$(
  kubectl \
    -n "$RELEASE_NAMESPACE" \
    get secrets \
    -l "${LABEL_KEY}=${LABEL_VALUE}" \
    -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
)"; then
  log "failed to list rotator-managed secrets in namespace ${RELEASE_NAMESPACE}"
  exit 1
fi

if [ -z "$managed_secrets" ]; then
  log "no rotator-managed cluster secrets found in namespace ${RELEASE_NAMESPACE}"
  exit 0
fi

failure_count=0

for secret_name in $managed_secrets; do
  if ! reconcile_secret "$secret_name"; then
    failure_count=$((failure_count + 1))
  fi
done

if [ "$failure_count" -gt 0 ]; then
  log "${failure_count} secret reconciliation(s) failed"
  exit 1
fi

log "cluster credential rotation completed successfully"
